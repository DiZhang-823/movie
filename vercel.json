{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd movie-frontend && npm install",
  "buildCommand": "cd movie-frontend && npm run build",
  "outputDirectory": "movie-frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
